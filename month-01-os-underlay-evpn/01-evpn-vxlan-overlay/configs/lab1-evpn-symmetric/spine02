spine02

nv set interface lo ipv4 address 10.255.255.2/32
nv set interface lo type loopback

nv set interface swp1-2 link state up
nv set interface swp1-2 type swp

nv set router bgp autonomous-system 65000
nv set router bgp router-id 10.255.255.2
nv set router bgp state enabled

nv set system hostname spine02
nv set vrf default router bgp router-id 10.255.255.2
nv set vrf default router bgp state enabled
nv set vrf default router bgp address-family ipv4-unicast network 10.255.255.2/32
nv set vrf default router bgp address-family ipv4-unicast state enabled
nv set vrf default router bgp address-family l2vpn-evpn state enabled

nv set vrf default router bgp autonomous-system 65000
nv set vrf default router bgp neighbor swp1 address-family ipv4-unicast state enabled
nv set vrf default router bgp neighbor swp1 address-family l2vpn-evpn state enabled
nv set vrf default router bgp neighbor swp1 remote-as external
nv set vrf default router bgp neighbor swp1 type unnumbered

nv set vrf default router bgp neighbor swp2 address-family ipv4-unicast state enabled
nv set vrf default router bgp neighbor swp2 address-family l2vpn-evpn state enabled
nv set vrf default router bgp neighbor swp2 remote-as external
nv set vrf default router bgp neighbor swp2 type unnumbered

nv set nve vxlan state enabled